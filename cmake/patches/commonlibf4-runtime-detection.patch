 		[[nodiscard]] std::size_t id2offset(std::uint64_t a_id) const;
 
+		// DSD patch: on 1.10.98x / 1.11.x a missing ID aborts the game ("strict"), but only once the plugin has called
+		// SetStrictLookup(true). Before that (while the DLL loads) the fork's own namespace-scope
+		// "inline REL::Relocation x{ REL::ID(n) }" globals look up their IDs, none of which DSD uses; a missing one
+		// resolves to offset 0 there instead of aborting the load.
+		static void SetStrictLookup(bool a_strict) noexcept { _strictLookup = a_strict; }
+
 #ifdef ENABLE_FALLOUT_VR
 		bool IsVRAddressLibraryAtLeastVersion(const char* a_minimalVRAddressLibVersion, bool a_reportAndFail = false) const;
 #endif
